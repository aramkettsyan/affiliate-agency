# Copy this file to ".env" (which is git-ignored) and fill in real values.
# The .env file is NEVER committed, so secrets stay off the public repo.

# ClickBank API keys (generate in ClickBank: Settings -> API Management).
# Optional — only needed if/when we build automated API-based product discovery.
CLICKBANK_DEV_KEY=
CLICKBANK_CLERK_KEY=

# Affiliate nickname (not secret; already public in links)
AFFILIATE_NICKNAME=aram094

# Facebook Page auto-poster (post_to_facebook.py).
# FB_PAGE_ID = the numeric Page ID (Page -> About -> Page transparency).
# FB_PAGE_ACCESS_TOKEN = a LONG-LIVED *Page* token (not a User token) with
# pages_manage_posts + pages_read_engagement. Verify: python post_to_facebook.py --check
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
